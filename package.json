{
  "name": "brokeboy",
  "version": "0.1.0-alpha.2",
  "description": "Billing, credits, and entitlements in your application and database.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/opcodehq/brokeboy.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "src"
  ],
  "bin": {
    "brokeboy": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "import": "./dist/drizzle.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    },
    "./stripe": {
      "types": "./dist/stripe.d.ts",
      "import": "./dist/stripe.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./schema/postgres": {
      "types": "./dist/schemas/postgres.d.ts",
      "import": "./dist/schemas/postgres.js"
    },
    "./schema/mysql": {
      "types": "./dist/schemas/mysql.d.ts",
      "import": "./dist/schemas/mysql.js"
    },
    "./schema/sqlite": {
      "types": "./dist/schemas/sqlite.d.ts",
      "import": "./dist/schemas/sqlite.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "import": "./dist/effect.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    },
    "./native/effect": {
      "types": "./dist/native-effect.d.ts",
      "import": "./dist/native-effect.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "test:integration": "bun test test/sqlite.test.ts test/sql.test.ts",
    "test:node": "node --experimental-strip-types --test test/node.contract.ts",
    "check": "bun run schemas:check && bun run lint && bun run build && bun run check-types && bun run test && bun run test:node && bun run test:neon",
    "test:d1": "node --experimental-strip-types --test test/d1.node.ts",
    "test:stripe-sandbox": "bun scripts/stripe-sandbox.ts",
    "benchmark": "bun scripts/benchmark.ts",
    "test:neon": "node --experimental-strip-types --test test/neon.node.ts",
    "demo": "bun examples/react-demo/index.ts",
    "schemas:generate": "bun scripts/generate-schema.ts",
    "schemas:check": "bun scripts/generate-schema.ts --check",
    "native:build": "bun scripts/build-native.ts",
    "test:native:node": "node --test-timeout=60000 --experimental-strip-types --test test/native.contract.ts test/native.stripe.ts test/native.sdk.ts",
    "test:native:bun": "bun test --timeout 30000 ./test/native.contract.ts ./test/native.stripe.ts ./test/native.sdk.ts ./test/native.parity.ts",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --all-features --locked -- -D warnings && cargo test --workspace --all-features --locked",
    "types:generate": "bun scripts/generate-types.ts",
    "types:check": "bun scripts/generate-types.ts --check",
    "native:stage": "node scripts/stage-native.mjs",
    "benchmark:native": "node scripts/benchmark-native.mjs",
    "test:stripe-sandbox:native": "BROKEBOY_SANDBOX_ENGINE=rust bun scripts/stripe-sandbox.ts",
    "test:native:parity": "bun test --timeout 30000 ./test/native.parity.ts"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.44.0 <1.0.0",
    "stripe": ">=23.0.1 <24.0.0",
    "react": ">=18.0.0 <20.0.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "stripe": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@cloudflare/workers-types": "5.20261027.1",
    "@neondatabase/serverless": "^1.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "miniflare": "^4.20260730.0",
    "mysql2": "^3.15.0",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "23.0.1",
    "typescript": "^5.9.0",
    "wrangler": "4.153.0",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "effect": "4.0.7",
    "jiti": "^2.6.0"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "esbuild",
    "workerd"
  ]
}
