{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["bun", "node"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src", "test", "examples", "scripts"]
}
