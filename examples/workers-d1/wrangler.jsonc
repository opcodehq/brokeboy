{
  "name": "brokeboy-d1-example",
  "main": "index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brokeboy",
      "database_id": "replace-with-your-database-id"
    }
  ]
}
